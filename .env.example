# =============================================================================
# Lavi MD Shipping Audit — environment configuration
# Copy to .env.local (dev) or set in your host's dashboard (production).
# NEVER commit a real .env file. All values below are placeholders.
# =============================================================================

# --- Application ------------------------------------------------------------
APP_URL=https://shipping.lavimd.store
NODE_ENV=production

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Shared secret required by /api/cron/* endpoints.
# Send as: Authorization: Bearer <CRON_SECRET>   (or ?secret= for schedulers that
# cannot set headers). Generate the same way as SESSION_SECRET.
CRON_SECRET=

# --- Database ---------------------------------------------------------------
# Postgres connection string. Add ?sslmode=require for most managed providers.
DATABASE_URL=postgresql://user:password@host:5432/lavimd_shipping?sslmode=require
# Set to "true" only if your provider uses a self-signed certificate.
DATABASE_SSL_NO_VERIFY=false

# --- ShipStation (API V2) ---------------------------------------------------
# ShipStation Settings > Account > API Settings > "V2 API Keys".
# V1 keys (key + secret pair) are deprecated and will NOT work here.
SHIPSTATION_API_KEY=
SHIPSTATION_API_BASE_URL=https://api.shipstation.com

# Which ShipStation stores to pull from. Comma-separated.
# Preferred: numeric/string store_id values (exact match, fastest).
#   Find them via `npm run sync -- --list-stores` after the API key is set.
SHIPSTATION_STORE_IDS=
# Fallback/extra: match on store name (case-insensitive). Used when a
# shipment's store_id is not in SHIPSTATION_STORE_IDS but its name matches.
SHIPSTATION_STORE_NAMES=Lavi MD Manual Orders,Lavi MD Retail Website,Lavi MD Shopify Store
# If both lists are empty the sync ingests every store (not recommended).

# --- UPS Developer APIs -----------------------------------------------------
# developer.ups.com > My Apps > (your app) > Client ID / Secret.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
# Your 6-character UPS shipper/account number. Used to attribute Quantum View
# manifest events and to distinguish our own labels from inbound shipments.
UPS_ACCOUNT_NUMBER=
# Production: https://onlinetools.ups.com   |  CIE/test: https://wwwcie.ups.com
UPS_API_BASE_URL=https://onlinetools.ups.com
# Sent on every Track request for UPS-side request tracing.
UPS_TRANSACTION_SRC=lavimd-shipping-audit

# Quantum View subscription name(s) to poll, comma-separated. Leave blank to
# retrieve ALL subscriptions on the account (recommended starting point).
# Quantum View is what surfaces UPS-account labels that never touch ShipStation
# (Danielle's wholesale labels). See docs/UPS_SETUP.md.
UPS_QUANTUM_VIEW_SUBSCRIPTIONS=
# Set to "false" to disable Quantum View polling (tracking-only mode).
UPS_QUANTUM_VIEW_ENABLED=true

# --- Email ------------------------------------------------------------------
# One of: resend | sendgrid | postmark | smtp | console
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=shipping-audit@lavimd.store
EMAIL_FROM_NAME=Lavi MD Shipping Audit
# Comma-separated recipient list for the 8:00 AM report.
EMAIL_RECIPIENTS=

# SMTP settings (only when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Behaviour tuning -------------------------------------------------------
# Hours after label creation with no physical UPS scan before a shipment is
# escalated to "Label >24 Hours — No UPS Scan".
AGING_LABEL_HOURS=24
# How far back each incremental sync looks for new/changed ShipStation labels.
SYNC_LOOKBACK_HOURS=72
# Stop re-polling UPS tracking once a shipment has been delivered this long ago.
TRACKING_REFRESH_DELIVERED_DAYS=7
# Max UPS tracking lookups per sync run (protects serverless time limits).
TRACKING_MAX_LOOKUPS_PER_RUN=250
# Display timezone. Timestamps are always STORED in UTC.
DISPLAY_TIMEZONE=America/New_York
# Log level: debug | info | warn | error
LOG_LEVEL=info
