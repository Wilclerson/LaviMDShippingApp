  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
